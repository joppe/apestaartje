{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "printWidth": 80,
  "ignorePatterns": [
    ".cache",
    ".idea",
    ".git",
    ".vscode",
    "node_modules",
    "pnpm-lock.yaml",
    "public",
  ],
  "organizeImports": {
    "groups": [["builtin", "external"], ["@apestaartje/**"], ["../"], ["./"]],
  },
}
